{
  "branches": [
    "main"
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "verifyReleaseCmd": "[ \"$EXPECTED_VERSION\" = next-version-dry-run ] || [ \"${nextRelease.version}\" = \"$EXPECTED_VERSION\" ] || { echo \"semantic-release wants ${nextRelease.version}, but '$EXPECTED_VERSION' was built\" >&2; exit 1; }"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/*.tar.gz"
          },
          {
            "path": "dist/*.flatpak"
          },
          {
            "path": "dist/ipmi-connect_*.cdx.json",
            "label": "SBOM (CycloneDX)"
          },
          {
            "path": "dist/ipmi-connect-desktop_*.cdx.json",
            "label": "SBOM, desktop build (CycloneDX)"
          },
          {
            "path": "dist/sha256sums.txt",
            "label": "SHA256 Checksums"
          }
        ],
        "successComment": false,
        "failComment": false,
        "releasedLabels": false
      }
    ]
  ]
}
